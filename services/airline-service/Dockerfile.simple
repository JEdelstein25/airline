FROM golang:1.21-alpine

WORKDIR /app

# Install necessary tools
RUN apk add --no-cache git

# Copy source code
COPY . .

# Download dependencies
RUN go mod tidy || true

# Build the application
RUN go build -o airline-service main.go || echo "Build failed but continuing for development"

EXPOSE 8001

# Use a shell script to start the service or echo an error
CMD ["sh", "-c", "if [ -f /app/airline-service ]; then /app/airline-service; else echo \"Build failed - check code\" && tail -f /dev/null; fi"]